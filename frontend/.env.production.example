# Frontend 운영 build 환경변수 예시입니다.
#
# ⚠ VITE_* 값은 **build 시점에 번들 안으로 인라인**됩니다.
#    서버 `.env`나 docker-compose에 넣어도 반영되지 않습니다. `npm run build`를 실행하는
#    그 자리(로컬 수동 빌드 또는 GitHub Actions)에서 주입해야 합니다.
#    값을 바꾸면 반드시 다시 빌드하고 `frontend/dist`를 다시 배포합니다.
#
# 사용:
#   cp frontend/.env.production.example frontend/.env.production
#   # 값을 채운 뒤
#   cd frontend && npm ci && npm run build
#
# 실제 IP, 도메인, API Key, Secret은 저장소에 커밋하지 않습니다.
# `frontend/.env.production`은 .gitignore 대상입니다.

# API base URL.
#
# 운영은 호스트 nginx가 같은 도메인에서 /api를 backend로 넘기므로 **비워 둡니다.**
# 비우면 same-origin 상대경로로 요청합니다(`apiClient.ts`). 도메인을 적어 넣으면
# 도메인이 바뀔 때마다 재빌드해야 하고, CORS 경계가 불필요하게 넓어집니다.
VITE_API_BASE_URL=

# Kakao Maps JavaScript SDK App Key.
#
# 비우면 만남 장소 지도, 관리자 좌표 선택기, 장소 검색이 동작하지 않습니다
# (KakaoMeetingPointMap, KakaoCoordinatePicker, KakaoPlaceSearch).
# 이 키는 Kakao 콘솔의 "플랫폼 > Web 사이트 도메인" 목록으로 통제되므로,
# 운영 도메인을 등록한 키를 사용해야 합니다.
VITE_KAKAO_MAPS_APP_KEY=<PROD_KAKAO_JAVASCRIPT_APP_KEY>

# 약관·개인정보처리방침에 표시할 문의 이메일.
# backend의 SUPPORT_CONTACT_EMAIL과 같은 값을 넣습니다.
# 비워 두면 문구 자리에 "설정되지 않았습니다" 안내가 그대로 노출됩니다.
VITE_SUPPORT_CONTACT_EMAIL=<SUPPORT_CONTACT_EMAIL>

# VITE_DEV_FESTIVAL_ID는 운영 build에 넣지 않습니다.
# `import.meta.env.DEV` 가드가 있어 운영 번들에서는 무시됩니다(MatchingConditionPage).
