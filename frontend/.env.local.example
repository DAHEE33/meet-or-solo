# local 개발에서는 값을 비워두고 Vite proxy로 /api 요청을 backend에 전달한다.
VITE_API_BASE_URL=

# 체크인 연동 전 local 개발에서만 사용할 festival ID. 운영 build에서는 무시된다.
VITE_DEV_FESTIVAL_ID=

# Kakao Maps JavaScript SDK App Key. 실제 Key는 개인 env에만 입력한다.
VITE_KAKAO_MAPS_APP_KEY=<KAKAO_JAVASCRIPT_APP_KEY>

# 약관·개인정보처리방침에 표시할 문의 이메일. backend의 SUPPORT_CONTACT_EMAIL과 같은 값을 넣는다.
# 비워두면 문구 자리에 "설정되지 않았습니다" 안내가 그대로 표시된다.
VITE_SUPPORT_CONTACT_EMAIL=
