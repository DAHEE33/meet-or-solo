# =============================================================================
# meet-or-solo 루트 .env 템플릿
#
# 이 파일을 복사해 개인 .env를 만든다. 실제 값은 커밋하지 않는다.
#   Windows : Copy-Item .env.example .env
#   bash    : cp .env.example .env
#
# 이 파일을 읽는 곳
#   - Spring Boot local profile : application-local.yml이 루트 .env를 optional config로 읽는다.
#   - docker-compose.local.yml  : docker compose --env-file .env 로 전달한다.
#
# 이 파일에 넣지 않는 것
#   - Frontend VITE_* 값 : frontend/.env.local.example 사용
#   - dev 서버 배포 값   : infra/env/.env.dev.example 사용
# =============================================================================

# -----------------------------------------------------------------------------
# 공통
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
AUTH_COOKIE_SECURE=false
TZ=Asia/Seoul
PGTZ=Asia/Seoul

# -----------------------------------------------------------------------------
# local DB (docker-compose.local.yml PostgreSQL)
# host 포트를 바꿨다면 DB_PORT도 같이 바꾼다.
# -----------------------------------------------------------------------------
POSTGRES_DB=meet_or_solo_local
POSTGRES_USER=meet_user
POSTGRES_PASSWORD=meet_password
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# 암호화 / 인증
# -----------------------------------------------------------------------------
# AES-256: 임의의 32바이트 key를 표준 Base64로 인코딩한 값
PROFILE_ENCRYPTION_KEY=<BASE64_ENCODED_32_BYTE_KEY>
JWT_SECRET=<JWT_SECRET_AT_LEAST_32_BYTES>
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=20160
ADMIN_REPORT_CURSOR_HMAC_SECRET=<replace-with-strong-random-secret>

# -----------------------------------------------------------------------------
# OAuth (Kakao / Naver)
# -----------------------------------------------------------------------------
KAKAO_CLIENT_ID=<KAKAO_REST_API_KEY>
KAKAO_CLIENT_SECRET=<KAKAO_CLIENT_SECRET>
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback
NAVER_CLIENT_ID=<NAVER_CLIENT_ID>
NAVER_CLIENT_SECRET=<NAVER_CLIENT_SECRET>
NAVER_REDIRECT_URI=http://localhost:8080/api/auth/naver/callback
NAVER_AUTHORIZATION_URI=https://nid.naver.com/oauth2.0/authorize
NAVER_TOKEN_URI=https://nid.naver.com/oauth2.0/token
NAVER_USER_INFO_URI=https://openapi.naver.com/v1/nid/me
NAVER_CONNECT_TIMEOUT=3s
NAVER_READ_TIMEOUT=5s

# -----------------------------------------------------------------------------
# OCI Object Storage (S3 compatible, 프로필 이미지)
# -----------------------------------------------------------------------------
OCI_OBJECT_STORAGE_ENDPOINT=https://<OBJECT_STORAGE_NAMESPACE>.compat.objectstorage.<OCI_REGION>.oraclecloud.com
OCI_OBJECT_STORAGE_REGION=<OCI_REGION>
OCI_OBJECT_STORAGE_ACCESS_KEY=<OCI_CUSTOMER_SECRET_KEY_ACCESS_KEY>
OCI_OBJECT_STORAGE_SECRET_KEY=<OCI_CUSTOMER_SECRET_KEY_SECRET>
OCI_OBJECT_STORAGE_BUCKET=meet-or-solo-assets
OCI_OBJECT_STORAGE_PROFILE_PREFIX=profiles/local
PROFILE_IMAGE_MAX_SIZE=5MB

# -----------------------------------------------------------------------------
# OpenAI 임베딩 (WBS 10-B 취향 임베딩)
# API Key가 비어 있으면 기동은 되지만 임베딩 생성이 실패하고
# embedding_status = FAILED 로만 저장된다.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CONNECT_TIMEOUT=5s
OPENAI_READ_TIMEOUT=10s

# -----------------------------------------------------------------------------
# 매칭 점수 · 스케줄러
# -----------------------------------------------------------------------------
# 태그 Jaccard 대 임베딩 코사인 유사도 가중치. 두 값의 합은 1이어야 하며 어긋나면 기동 실패.
# 실사용 매칭 데이터를 확보한 뒤 조정한다.
MATCHING_SCORING_JACCARD_WEIGHT=0.70
MATCHING_SCORING_EMBEDDING_WEIGHT=0.30

MATCHING_SCHEDULER_ENABLED=true
MATCHING_SCHEDULER_FIXED_DELAY=5s
MATCHING_SCHEDULER_BATCH_SIZE=20
MATCHING_STALE_TIMEOUT=30s
MATCHING_PROPOSAL_TIMEOUT=30s
MATCHING_NO_SHOW_SCHEDULER_ENABLED=false

# -----------------------------------------------------------------------------
# 관리자 제재 스케줄러
# -----------------------------------------------------------------------------
ADMIN_MEMBER_SUSPENSION_SCHEDULER_ENABLED=false
ADMIN_MEMBER_SUSPENSION_SCHEDULER_FIXED_DELAY=60000

# -----------------------------------------------------------------------------
# dev / prod profile 전용 (local에서는 사용하지 않는다)
# SPRING_PROFILES_ACTIVE=dev 또는 prod로 띄울 때만 아래 주석을 해제한다.
# 실제 dev 서버 배포 값은 infra/env/.env.dev.example을 기준으로 서버에서 관리한다.
# -----------------------------------------------------------------------------
# DB_URL=jdbc:postgresql://<DB_HOST>:5432/meet_or_solo_dev
# DB_USERNAME=<DB_USERNAME>
# DB_PASSWORD=<DB_PASSWORD>
