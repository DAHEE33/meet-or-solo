SPRING_PROFILES_ACTIVE=dev
TZ=Asia/Seoul
PGTZ=Asia/Seoul

POSTGRES_DB=meet_or_solo_dev
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

DB_URL=jdbc:postgresql://postgres:5432/meet_or_solo_dev
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# 브라우저가 실제로 여는 origin을 그대로 적습니다. REST CORS뿐 아니라 WebSocket handshake
# origin 검사에도 같은 값이 쓰입니다(WebSocketConfig). 도메인으로 접속하는데 여기에
# host:port만 있으면 handshake가 403으로 거절됩니다. 여러 개면 쉼표로 구분합니다.
CORS_ALLOWED_ORIGINS=https://<DEV_DOMAIN>,http://<DEV_SERVER_HOST>:18080
FRONTEND_BASE_URL=https://<DEV_DOMAIN>
# 도메인에 TLS를 붙였으면 true로 올립니다.
AUTH_COOKIE_SECURE=false
# AES-256: 임의의 32바이트 key를 표준 Base64로 인코딩한 값
PROFILE_ENCRYPTION_KEY=<BASE64_ENCODED_32_BYTE_KEY>
SERVER_PORT=8080

OCI_OBJECT_STORAGE_ENDPOINT=https://<OBJECT_STORAGE_NAMESPACE>.compat.objectstorage.<OCI_REGION>.oraclecloud.com
OCI_OBJECT_STORAGE_REGION=<OCI_REGION>
OCI_OBJECT_STORAGE_ACCESS_KEY=<OCI_CUSTOMER_SECRET_KEY_ACCESS_KEY>
OCI_OBJECT_STORAGE_SECRET_KEY=<OCI_CUSTOMER_SECRET_KEY_SECRET>
OCI_OBJECT_STORAGE_BUCKET=meet-or-solo-assets
OCI_OBJECT_STORAGE_PROFILE_PREFIX=profiles/dev
PROFILE_IMAGE_MAX_SIZE=5MB

TOURISM_API_KEY=<TOUR_API_DECODING_KEY>
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=SoloIn
TOUR_API_CONNECT_TIMEOUT=3s
TOUR_API_READ_TIMEOUT=10s
# 축제 Scheduler 소유자는 dev backend 한 인스턴스로 고정한다.
FESTIVAL_SYNC_ENABLED=true
FESTIVAL_SYNC_INITIAL_DELAY=10s
FESTIVAL_SYNC_FIXED_DELAY=6h
FESTIVAL_SYNC_PAGE_SIZE=100
FESTIVAL_SYNC_MAX_PAGES=100
FESTIVAL_SYNC_LOOKBACK_DAYS=30
FESTIVAL_SYNC_LOOKAHEAD_DAYS=365
FESTIVAL_SYNC_REGION_CODE=51
FESTIVAL_SYNC_CLASSIFICATION_SYSTEM_1=EV
FESTIVAL_SYNC_CLASSIFICATION_SYSTEM_2=EV01
FESTIVAL_SYNC_RETRY_MAX_ATTEMPTS=3
FESTIVAL_SYNC_RETRY_INITIAL_DELAY=1s
FESTIVAL_SYNC_RETRY_MAX_DELAY=10s

KAKAO_CLIENT_ID=<KAKAO_REST_API_KEY>
KAKAO_CLIENT_SECRET=<KAKAO_CLIENT_SECRET>
KAKAO_REDIRECT_URI=http://<DEV_SERVER_HOST>:18080/api/auth/kakao/callback
NAVER_CLIENT_ID=<NAVER_CLIENT_ID>
NAVER_CLIENT_SECRET=<NAVER_CLIENT_SECRET>
NAVER_REDIRECT_URI=http://<DEV_SERVER_HOST>:18080/api/auth/naver/callback
JWT_SECRET=<JWT_SECRET_AT_LEAST_32_BYTES>
ADMIN_REPORT_CURSOR_HMAC_SECRET=<replace-with-strong-random-secret>
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=20160

# 매칭 Scheduler.
# application.yml 기본값은 false다. dev 컨테이너는 루트 .env를 읽지 않으므로 여기서
# 주입하지 않으면 제안 timeout(30초)·노쇼 처리·배치 매칭이 기동하지 않는다.
MATCHING_SCHEDULER_ENABLED=true
MATCHING_NO_SHOW_SCHEDULER_ENABLED=true
MATCHING_SCHEDULER_FIXED_DELAY=5s
MATCHING_STALE_TIMEOUT=30s
MATCHING_PROPOSAL_TIMEOUT=30s
MATCHING_SCHEDULER_BATCH_SIZE=20
# 두 값의 합은 반드시 1이어야 한다. 어긋나면 backend가 기동에 실패한다.
MATCHING_SCORING_JACCARD_WEIGHT=0.70
MATCHING_SCORING_EMBEDDING_WEIGHT=0.30

# 취향 임베딩. 비어 있으면 임베딩 등록이 항상 실패한다.
OPENAI_API_KEY=<OPENAI_API_KEY>

# 제재 안내에 노출할 문의 이메일. 비우면 문의 문구를 숨긴다.
SUPPORT_CONTACT_EMAIL=<SUPPORT_EMAIL>

# 정지 만료 자동 복구 Scheduler.
ADMIN_MEMBER_SUSPENSION_SCHEDULER_ENABLED=true

# 개발계 GPS 반경·정확도 검증 우회. GPS 검증 회차에서만 false로 바꾼다.
FESTIVAL_CHECKIN_BYPASS_RADIUS_CHECK=true
