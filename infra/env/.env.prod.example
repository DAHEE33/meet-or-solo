# =============================================================================
# meet-or-solo 운영(prod) 서버 .env 템플릿
#
# 이 파일은 저장소에 커밋되는 **예시**입니다. 실제 서버 `.env`는 Oracle VM의
# `/home/ubuntu/meet-or-solo-prod/.env`에 서버 관리자가 직접 만들고 커밋하지 않습니다.
#
#   cp infra/env/.env.prod.example .env    (운영 서버에서)
#   chmod 600 .env
#
# 읽는 곳: docker compose --env-file .env -f infra/docker/docker-compose.prod.yml
#
# ⚠ Secret 분리 원칙 (docs/06)
#   아래 값들은 **dev와 반드시 다른 값**을 새로 만듭니다. 같은 값을 쓰면 개발 환경에서
#   유출된 하나로 운영 데이터까지 열립니다.
#     POSTGRES_PASSWORD / DB_PASSWORD, JWT_SECRET, PROFILE_ENCRYPTION_KEY,
#     ADMIN_REPORT_CURSOR_HMAC_SECRET, ADMIN_LOCAL_PASSWORD, WEB_PUSH_VAPID_*
#
#   외부 서비스 키는 성격이 다릅니다.
#     - Kakao / Naver OAuth : **분리 필요.** redirect URI가 애플리케이션에 등록된 값과
#       정확히 같아야 하므로, 운영 도메인을 등록한 별도 애플리케이션을 쓰는 것이 원칙입니다.
#       하나의 애플리케이션에 URI를 둘 다 등록해 공유할 수도 있지만, 그러면 개발 실수가
#       운영 로그인에 바로 영향을 줍니다.
#     - Kakao Maps JavaScript 키 : **분리 권장.** 허용 도메인 목록으로 통제되는 키라
#       운영 도메인만 등록한 키를 따로 두면 유출 시 영향 범위가 좁아집니다.
#     - TourAPI(한국관광공사) : **공유 가능.** 도메인 개념이 없고 일일 호출 한도만 있습니다.
#       다만 dev와 운영이 같은 한도를 나눠 쓰므로 동기화 주기 설계에 반영합니다(docs/07 운영 수동 배포 절차 4절).
#     - OpenAI : **분리 권장.** 사용량과 비용을 운영/개발로 나눠 보기 위해서입니다.
#     - OCI Object Storage : 같은 키를 쓰더라도 `OCI_OBJECT_STORAGE_PROFILE_PREFIX`는
#       반드시 나눕니다. 같은 prefix면 개발 업로드가 운영 파일과 섞입니다.
#
# 이 파일에는 실제 도메인, IP, 비밀번호, 키를 절대 쓰지 않습니다. placeholder만 둡니다.
# =============================================================================

# -----------------------------------------------------------------------------
# 공통
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
TZ=Asia/Seoul
PGTZ=Asia/Seoul

# -----------------------------------------------------------------------------
# 운영 DB
# 같은 VM의 dev DB(meet_or_solo_dev)와 이름·계정을 모두 분리합니다.
# DB_URL의 host는 compose 내부 service name인 `postgres`입니다. host 포트가 아닙니다.
# -----------------------------------------------------------------------------
POSTGRES_DB=meet_or_solo_prod
POSTGRES_USER=<PROD_DB_USER>
POSTGRES_PASSWORD=<PROD_DB_PASSWORD>

DB_URL=jdbc:postgresql://postgres:5432/meet_or_solo_prod
DB_USERNAME=<PROD_DB_USER>
DB_PASSWORD=<PROD_DB_PASSWORD>

# -----------------------------------------------------------------------------
# 도메인 경계
#
# CORS_ALLOWED_ORIGINS는 브라우저가 실제로 여는 origin을 그대로 적습니다.
# REST CORS뿐 아니라 WebSocket handshake origin 검사에도 같은 값이 쓰입니다(WebSocketConfig).
# 운영은 도메인 하나만 둡니다. 개발 도메인이나 host:port를 섞지 않습니다.
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://<PROD_DOMAIN>
FRONTEND_BASE_URL=https://<PROD_DOMAIN>
# 운영은 HTTPS이므로 true입니다. false면 secure 속성 없이 cookie가 나갑니다.
AUTH_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# 암호화 / 인증 (전부 dev와 다른 값으로 새로 생성)
# -----------------------------------------------------------------------------
# AES-256: 임의의 32바이트 key를 표준 Base64로 인코딩한 값
# ⚠ 이 키를 바꾸면 기존에 암호화된 프로필 데이터를 더 이상 복호화할 수 없습니다.
#    운영 기동 후에는 교체하지 않습니다.
PROFILE_ENCRYPTION_KEY=<BASE64_ENCODED_32_BYTE_KEY>
JWT_SECRET=<JWT_SECRET_AT_LEAST_32_BYTES>
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=20160
# UTF-8 기준 32바이트 이상. 비거나 짧으면 backend가 기동에 실패합니다(의도된 설계).
ADMIN_REPORT_CURSOR_HMAC_SECRET=<PROD_ADMIN_REPORT_CURSOR_HMAC_SECRET>

# -----------------------------------------------------------------------------
# 슈퍼관리자 ID/PW 로그인 (docs/30-2)
#
# username과 password가 **둘 다** 있어야 기동 시 계정을 만들거나 비밀번호를 회전합니다.
# 하나라도 비면 아무것도 하지 않습니다. 기본 계정을 자동 생성하지 않기 위해서입니다.
#
# 이 값이 없으면 /admin/login으로 들어갈 수 없고, 그러면 /admin/members에서 회원 관리와
# 테스트 계정 지정을 할 수 없습니다. 운영에서는 반드시 채웁니다.
# -----------------------------------------------------------------------------
ADMIN_LOCAL_USERNAME=<PROD_ADMIN_USERNAME>
ADMIN_LOCAL_PASSWORD=<PROD_ADMIN_PASSWORD>
ADMIN_LOCAL_NICKNAME=슈퍼관리자

# -----------------------------------------------------------------------------
# OAuth (Kakao / Naver)
# redirect URI는 개발자 콘솔에 등록한 값과 **문자 단위로 같아야** 합니다.
# -----------------------------------------------------------------------------
KAKAO_CLIENT_ID=<PROD_KAKAO_REST_API_KEY>
KAKAO_CLIENT_SECRET=<PROD_KAKAO_CLIENT_SECRET>
KAKAO_REDIRECT_URI=https://<PROD_DOMAIN>/api/auth/kakao/callback
NAVER_CLIENT_ID=<PROD_NAVER_CLIENT_ID>
NAVER_CLIENT_SECRET=<PROD_NAVER_CLIENT_SECRET>
NAVER_REDIRECT_URI=https://<PROD_DOMAIN>/api/auth/naver/callback

# -----------------------------------------------------------------------------
# OCI Object Storage (프로필 이미지)
# prefix는 dev와 반드시 다르게 둡니다.
# -----------------------------------------------------------------------------
OCI_OBJECT_STORAGE_ENDPOINT=https://<OBJECT_STORAGE_NAMESPACE>.compat.objectstorage.<OCI_REGION>.oraclecloud.com
OCI_OBJECT_STORAGE_REGION=<OCI_REGION>
OCI_OBJECT_STORAGE_ACCESS_KEY=<OCI_CUSTOMER_SECRET_KEY_ACCESS_KEY>
OCI_OBJECT_STORAGE_SECRET_KEY=<OCI_CUSTOMER_SECRET_KEY_SECRET>
OCI_OBJECT_STORAGE_BUCKET=meet-or-solo-assets
OCI_OBJECT_STORAGE_PROFILE_PREFIX=profiles/prod
# 올리려면 nginx 두 곳의 client_max_body_size도 함께 올립니다(docs/07 운영 수동 배포 절차 5절).
PROFILE_IMAGE_MAX_SIZE=5MB

# -----------------------------------------------------------------------------
# 한국관광공사 TourAPI
# -----------------------------------------------------------------------------
TOURISM_API_KEY=<TOUR_API_DECODING_KEY>
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=SoloIn
TOUR_API_CONNECT_TIMEOUT=3s
TOUR_API_READ_TIMEOUT=10s

# -----------------------------------------------------------------------------
# 축제·관광지 동기화
#
# 운영 DB는 빈 상태로 시작합니다. dev DB를 복사하지 않으므로 축제·관광지 데이터도 비어
# 있습니다. 적재 방법과 시점은 docs/07 운영 수동 배포 절차 4절에 있습니다. 요약하면:
#
#   초기 적재  : 두 값을 true로 두고 한 번 기동해 채운 뒤, 적재가 끝나면 false로 되돌리고
#                재기동합니다. 적재 완료는 로그와 테이블 건수로 확인합니다.
#   정기 동기화: 운영에서 상시 켤지는 TourAPI 일일 호출 한도를 dev와 나눠 쓰는 점을 보고
#                정합니다. 상시로 켜려면 dev 쪽 스케줄러를 끄는 편이 안전합니다.
#
# 기본값은 둘 다 false입니다(application-prod.yml).
# -----------------------------------------------------------------------------
FESTIVAL_SYNC_ENABLED=false
TOUR_PLACE_SYNC_ENABLED=false
FESTIVAL_SYNC_FIXED_DELAY=6h
TOUR_PLACE_SYNC_FIXED_DELAY=12h
FESTIVAL_SYNC_REGION_CODE=51
TOUR_PLACE_SYNC_REGION_CODE=51

# -----------------------------------------------------------------------------
# 매칭 Scheduler
# 꺼지면 제안 timeout(30초), 노쇼 처리, 배치 매칭이 기동하지 않습니다.
# -----------------------------------------------------------------------------
MATCHING_SCHEDULER_ENABLED=true
MATCHING_NO_SHOW_SCHEDULER_ENABLED=true
# 후보 수집 주기. 즉시 조합 경로 제거 후에는 이 값이 한 배치에 모이는 시간이다.
# 세 scheduler가 이 값을 공유하므로 늘리면 제안 timeout·만남 종료 판정도 느슨해진다.
MATCHING_SCHEDULER_FIXED_DELAY=10s
MATCHING_STALE_TIMEOUT=30s
MATCHING_PROPOSAL_TIMEOUT=30s
MATCHING_SCHEDULER_BATCH_SIZE=20
# 두 값의 합은 반드시 1이어야 합니다. 어긋나면 backend가 기동에 실패합니다.
MATCHING_SCORING_JACCARD_WEIGHT=0.70
MATCHING_SCORING_EMBEDDING_WEIGHT=0.30

# 체크인·도착 인정 반경(미터).
FESTIVAL_CHECKIN_RADIUS_METERS=500
MATCHING_ARRIVAL_RADIUS_METERS=150
#
# ⚠ GPS 반경 검증 우회 스위치(FESTIVAL_CHECKIN_BYPASS_RADIUS_CHECK,
#   MATCHING_ARRIVAL_BYPASS_RADIUS_CHECK)는 이 파일에 **일부러 없습니다.**
#   application-prod.yml이 두 값을 false로 고정하므로 여기에 써 넣어도 켜지지 않습니다.
#   현장에 가지 않고 확인해야 하면 /admin/members에서 그 계정을 테스트 계정으로 지정합니다
#   (members.test_account). 계정 단위 면제라 일반 계정은 검증을 그대로 받습니다.

# -----------------------------------------------------------------------------
# 기타 Scheduler
# 공통 기본값이 false인 항목들입니다. 넘기지 않으면 운영에서 조용히 꺼집니다.
# -----------------------------------------------------------------------------
ADMIN_MEMBER_SUSPENSION_SCHEDULER_ENABLED=true
# 시간 경과 매너온도 회복(docs/19 4.9). 꺼지면 30도 매칭 제한이 풀리지 않습니다.
MANNER_TEMPERATURE_RECOVERY_SCHEDULER_ENABLED=true
# 1:1 문의 보관 기간 경과분 익명화(docs/29 5.6). 개인정보 보관 정책과 직결됩니다.
INQUIRY_RETENTION_SCHEDULER_ENABLED=true

# -----------------------------------------------------------------------------
# 취향 임베딩 / 문의
# -----------------------------------------------------------------------------
# 비면 임베딩 등록이 항상 EMBEDDING_API_FAILED로 실패합니다.
OPENAI_API_KEY=<PROD_OPENAI_API_KEY>
OPENAI_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 제재 안내에 노출할 문의 이메일. 비우면 문의 문구를 숨깁니다.
SUPPORT_CONTACT_EMAIL=<SUPPORT_EMAIL>

# -----------------------------------------------------------------------------
# Web Push (docs/32 3.4)
#
# 코드는 이미 구현돼 있습니다(WebPushSender, push_subscriptions, frontend/src/sw.ts).
# 키 쌍이 비면 **push 발송만** 꺼지고 WebSocket 알림과 서버 알림함은 그대로 동작합니다.
#
# 키 생성:  npx web-push generate-vapid-keys
# public key는 브라우저에 그대로 들어가는 값이지만 private key는 유출되면 우리 도메인
# 이름으로 누구나 push를 보낼 수 있습니다. 저장소에 넣지 않습니다.
#
# ⚠ 키를 교체하면 기존 구독이 전부 무효가 되어 사용자가 다시 권한을 허용해야 합니다.
# -----------------------------------------------------------------------------
WEB_PUSH_VAPID_PUBLIC_KEY=<PROD_WEB_PUSH_VAPID_PUBLIC_KEY>
WEB_PUSH_VAPID_PRIVATE_KEY=<PROD_WEB_PUSH_VAPID_PRIVATE_KEY>
WEB_PUSH_VAPID_SUBJECT=mailto:<CONTACT_EMAIL>
