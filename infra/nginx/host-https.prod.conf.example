# 운영 도메인의 TLS를 끊는 "호스트 nginx" 설정 예시입니다.
#
# 이 파일은 compose 안의 nginx(`infra/nginx/default.prod.conf`)와 다릅니다.
# compose nginx는 TLS 없이 `127.0.0.1:28080`에만 붙고, 실제 도메인 인증서는 Oracle VM에
# 직접 설치된 nginx가 처리합니다.
#
# dev 설정(`host-https.dev.conf.example`)과 같은 VM, 같은 nginx에 **나란히** 놓입니다.
# 개발과 운영은 이 server block 단위로 갈립니다.
#
# 적용:
#   1. `<PROD_DOMAIN>`과 인증서 경로를 실제 값으로 바꾼다.
#   2. `/etc/nginx/sites-available/meet-or-solo-prod`에 두고 `sites-enabled/`로 symlink한다.
#      ⚠ 확인 시점에 `sites-enabled/` 안의 운영 도메인 이름을 딴 파일이 실제로는 개발용
#        설정이었습니다. 파일명이 아니라 `server_name`과 `proxy_pass` 값을 보고 판단하세요.
#   3. sudo nginx -t && sudo systemctl reload nginx
#
# 실제 도메인, IP, 인증서 경로, Basic Auth 비밀번호는 저장소에 커밋하지 않습니다.

upstream meet_or_solo_prod {
    # compose nginx가 publish한 host port. `docker-compose.prod.yml`의
    # `127.0.0.1:28080:80`과 맞춥니다. dev는 18080이므로 섞이지 않게 확인하세요.
    server 127.0.0.1:28080;
}

server {
    listen 80;
    server_name <PROD_DOMAIN>;

    # Certbot 갱신 경로만 열어 두고 나머지는 HTTPS로 보냅니다.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        # 아래 Basic Auth를 켜더라도 이 경로는 인증 없이 열려 있어야 갱신이 됩니다.
        auth_basic off;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name <PROD_DOMAIN>;

    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/<PROD_DOMAIN>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<PROD_DOMAIN>/privkey.pem;

    # 업로드 상한. compose nginx(6m)와 같은 값을 둡니다. 둘 중 작은 쪽이 실제 상한입니다.
    client_max_body_size 6m;

    # -------------------------------------------------------------------------
    # 접근 제한 (현재 쓰지 않습니다)
    #
    # 일반 사용자가 운영 주소로 바로 접속하고, 회원 인증과 관리자 권한 검사는 앱 기능이
    # 담당합니다 - JWT cookie, /admin/login, MemberAccessInterceptor, 관리자 role 검사.
    #
    # 검토했다가 접은 이유는, Basic Auth를 켜 두면 PWA 설치·Service Worker 등록·Web Push가
    # 인증 뒤에서 동작해 그 상태의 검증 결과를 공개 상태의 결과로 믿을 수 없기 때문입니다.
    #
    # 다시 막아야 할 상황이 생기면 아래 두 줄의 주석을 풀고 계정 파일을 먼저 만드세요.
    #
    #   sudo apt-get install -y apache2-utils
    #   sudo htpasswd -c /etc/nginx/.htpasswd-meet-or-solo-prod <USERNAME>
    #   sudo chmod 640 /etc/nginx/.htpasswd-meet-or-solo-prod
    #   sudo chown root:www-data /etc/nginx/.htpasswd-meet-or-solo-prod
    #
    # ⚠ 켜게 되면 OAuth 로그인·PWA 설치·Web Push가 모두 인증 뒤에서 동작합니다.
    #   그 상태의 검증 결과를 "공개 상태에서도 된다"로 읽으면 안 됩니다.
    #
    # auth_basic           "meet-or-solo prod";
    # auth_basic_user_file /etc/nginx/.htpasswd-meet-or-solo-prod;

    # 검색 노출 차단 - 운영에서는 꺼 둡니다.
    #
    # 운영 도메인은 검색에 노출되어야 하므로 주석 처리합니다. 기능이 완성되기 전에
    # 잠시 가려야 하면 주석을 풀고 reload합니다.
    #
    # 개발 도메인에는 이 줄이 켜져 있습니다. index.html은 빌드 결과물 하나라 dev와 운영이
    # 같은 title·description·robots.txt를 갖는데, 개발 버전이 검색에 뜨면 같은 내용이
    # 두 주소로 잡혀 운영 순위까지 깎입니다.
    # add_header X-Robots-Tag "noindex, nofollow" always;
    # -------------------------------------------------------------------------

    # WebSocket(STOMP) 상태 동기화 전용 경로입니다.
    # `location /`보다 먼저 선언해야 하며, Upgrade header를 그대로 넘겨야 합니다.
    # 빠지면 handshake가 400이고, CORS_ALLOWED_ORIGINS에 이 도메인이 없으면 403입니다.
    location /ws {
        proxy_pass http://meet_or_solo_prod;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # STOMP heartbeat는 10초지만 유휴 연결이 기본 60초에 끊기지 않도록 넉넉히 둡니다.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://meet_or_solo_prod;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://meet_or_solo_prod;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
